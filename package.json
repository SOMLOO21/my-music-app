{
  "name": "my-music-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/migrate.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "test:booking": "node --experimental-transform-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/booking-test-hooks.mjs --test scripts/test-booking-isolation.mjs scripts/test-booking-import.mjs",
    "seed:booking": "node --env-file-if-exists=.env.local --experimental-transform-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/booking-test-hooks.mjs scripts/seed-booking-demo.mjs",
    "test:drop": "node --experimental-transform-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/booking-test-hooks.mjs --test \"scripts/test-drop-*.mjs\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.134.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@libsql/client": "^0.18.0",
    "@vercel/blob": "^2.8.2",
    "@vercel/sandbox": "^3.9.1",
    "@vercel/speed-insights": "^2.0.0",
    "ffmpeg-static": "^5.3.0",
    "hono": "^4.13.14",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "read-excel-file": "^9.3.14",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.4.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true
  }
}
