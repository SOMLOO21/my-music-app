{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "inspire",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "inspire" }],
  // Adresse gratuite *.workers.dev. Pour inspire.mymusicads.fr, le domaine doit d'abord être géré par Cloudflare
  // (il est aujourd'hui chez OVH) : ajouter alors "routes": [{ "pattern": "inspire.mymusicads.fr", "custom_domain": true }].
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "diggers-inspire",
      "database_id": "cdeb7b65-b1f9-40a2-9f59-ccb04c307aa2",
      "migrations_dir": "migrations"
    }
  ],
  "observability": { "enabled": true }
}
